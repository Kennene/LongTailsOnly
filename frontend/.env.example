# Skopiuj do `.env.local`, żeby nadpisać ustawienia lokalnie.

# `true` => odczyty idą z fixture'ów (`src/api/fixtures/`), mutacje zawsze do API.
# Przydatne, gdy backend jeszcze nie wstał albo gdy chcemy mieć pewność, że demo
# wygląda tak samo bez sieci. Domyślnie (brak zmiennej) panel czyta z API.
VITE_USE_FIXTURES=false
