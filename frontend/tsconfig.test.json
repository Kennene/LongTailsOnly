{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    /* Testy celowo dostają `node`: czytają pliki (np. arkusz motywu) i dokładnie tak samo
       traktuje je eslint (`long-tails-only/tests` dokłada `globals.node`). Kod aplikacji
       zostaje browser-only — to jedyny strażnik, bo typescript-eslint wyłącza `no-undef`. */
    "types": ["node", "vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Ścieżki i aliasy — `@shared` musi być tu powtórzony, bo `tsc` nie czyta `resolve.alias`
       z `vite.config.ts` (alias Vite obsługuje wyłącznie bundler i vitest). */
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test/**/*.ts",
    "src/test/**/*.tsx"
  ]
}
