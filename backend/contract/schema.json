          "type": "integer"
        },
        "justification": {
          "type": "string"
        },
        "lease_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lease_id": {
          "type": "integer"
        },
        "lease_is_active": {
          "type": "boolean"
        },
        "lease_role": {
          "$ref": "#/$defs/Role"
        },
        "previous_appeals": {
          "type": "integer"
        },
        "recent_activity_count": {
          "type": "integer"
        },
