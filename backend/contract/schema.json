          "type": "integer"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryRead"
        },
        "requested_role": {
          "$ref": "#/$defs/Role"
        },
        "resolved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/AppealStatus"
        },
        "user": {
          "$ref": "#/$defs/UserRead"
        },
        "user_id": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "lease_id",
        "user_id",
        "repo_id",
        "requested_role",
        "justification",
        "status",
        "created_at",
        "resolved_at",
        "user",
        "repository",
        "lease_role",
        "lease_expires_at",
        "lease_is_active",
        "days_remaining",
        "recent_activity_count",
        "previous_appeals"
