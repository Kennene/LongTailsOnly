      },
      "required": [
        "mode"
      ],
      "title": "EnforcementModeUpdate",
      "type": "object"
    },
    "Extension": {
      "description": "Exactly one way of extending a lease (ADR 0005).",
      "properties": {
        "custom_days": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 365,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "multiplier": {
          "anyOf": [
            {
              "enum": [
                1.5,
                2.0
              ],
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "preset_days": {
          "anyOf": [
            {
              "enum": [
                7,
                14,
                30,
                90
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "until_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Extension",
      "type": "object"
    },
