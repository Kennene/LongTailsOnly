{
  "id": "uc-04-time-travel",
  "use_case": "UC-4",
  "title": "Cykl życia dzierżawy: ACTIVE → WARNING → EXPIRED",
  "given": {
    "anchor": "2026-10-03T00:00:00Z",
    "seed": "default",
    "relies_on": ["kamil", "core-api"],
    "note": "kamil@core-api ma TTL do 2026-11-01T10:00:00Z. Skok +25 dni wprowadza dzierżawę w okno ostrzegawcze (4 dni), kolejne +5 dni (razem 30) ją wygasza."
  },
  "when": [
    { "type": "reset" },
    { "type": "api", "method": "GET", "path": "/api/v1/leases", "as": "t0" },
    { "type": "time_travel", "days": 25 },
    { "type": "api", "method": "GET", "path": "/api/v1/leases", "as": "t25" },
    { "type": "time_travel", "days": 5 },
    { "type": "api", "method": "GET", "path": "/api/v1/leases", "as": "t30" }
  ],
  "then": [
    {
      "target": "t0",
      "model": "LeaseOverview",
      "where": { "user.login": "kamil", "repository.name": "core-api" },
      "expect": { "status": "ACTIVE", "days_remaining": 28 }
    },
    {
      "target": "t25",
      "model": "LeaseOverview",
      "where": { "user.login": "kamil", "repository.name": "core-api" },
      "expect": { "status": "WARNING", "days_remaining": 4 }
    },
    {
      "target": "t30",
      "model": "LeaseOverview",
      "where": { "user.login": "kamil", "repository.name": "core-api" },
      "expect": { "status": "EXPIRED", "recommendation": "KEEP" }
    }
  ]
}
